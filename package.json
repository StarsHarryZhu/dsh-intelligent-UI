{
  "name": "dsh-intelligent-ui",
  "version": "0.1.1",
  "description": "Intelligent UI for DeepSeek Harness: the model writes a small catalogued interface program, the chat renders it as a native card with sliders, tables, charts, function plots, and typeset formulas, and every control change recomputes in the browser with zero model calls.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "generative-ui",
    "interactive-card",
    "calculus",
    "plot",
    "formula"
  ],
  "author": "Starfield (https://github.com/StarsHarryZhu)",
  "homepage": "https://github.com/StarsHarryZhu/dsh-intelligent-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarsHarryZhu/dsh-intelligent-UI.git"
  },
  "bugs": {
    "url": "https://github.com/StarsHarryZhu/dsh-intelligent-UI/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README-zh.md",
    "AGENTS.md"
  ],
  "scripts": {
    "link-dev": "node scripts/link-dev.mjs",
    "build": "node build.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.client.json",
    "test": "node build.js && node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0-0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1 <0.3.0-0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT"
}
