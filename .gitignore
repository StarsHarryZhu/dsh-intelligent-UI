# --- Build residue ----------------------------------------------------------
#
# The client transpile scratch directory. `node build.js` deletes and recreates
# it on every run, and nothing reads it afterwards.
.client-build/

# `lib/` is deliberately NOT ignored. It is the published artifact, it is what a
# profile's `link:` install resolves, and this package has no `prepare` script,
# so nothing regenerates it on install. Committing it is what keeps `link:` and
# `file:` installs working on a fresh clone. It is still generated: change
# `src/` and run `node build.js`, never edit `lib/` by hand.
!lib/

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Test and type-check output ---------------------------------------------
coverage/
.vitest/
*.tsbuildinfo

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Packed tarballs --------------------------------------------------------
*.tgz

# --- Local assistant memory -------------------------------------------------
# Private notes for one machine's coding assistant; never part of the package.
.claude/

# --- Unpublished working notes ----------------------------------------------
# The market submission (the list entry, the pre-flight checks, and the pull
# request text) is prepared beside the code but is not published with it; it is
# submitted to the list by hand. The folder stays in the working tree, and git
# carries none of it.
docs/market/

# --- Local environment ------------------------------------------------------
.env
.env.*
!.env.example

# --- Editors ----------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# --- Operating system -------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# --- Caches -----------------------------------------------------------------
.cache/
.turbo/
.eslintcache
